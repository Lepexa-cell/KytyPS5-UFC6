#version 450

// Step 3: color-clear metadata predicate with fused writeback. The guest compute shader
// fills each 4 KiB DCC/CMASK slice with one uniform code byte. One invocation per slice:
// it checks the slice dwords in the buffer cache's GPU copy against the candidate values
// (replicated expected code bytes decoded on the CPU), writes one predicate dword per
// candidate code, and fills matched slices with 0xFFFFFFFF (the CPU WriteBacking
// equivalent, so the CPU backing stays stale and the range stays GPU-modified for a lazy
// download later). Predicates for unused candidate slots are cleared.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Meta {
    uint words[];
} meta;

layout(std430, binding = 1) buffer Pred {
    uint pred[];
};

layout(push_constant) uniform Push {
    uint meta_base_dword;
    uint slice_stride_dword;
    uint slice_dwords;
    uint slice_count;
    uint code_count;
    uint code0;
    uint code1;
    uint code2;
    uint code3;
} pc;

void main() {
    const uint slice = gl_GlobalInvocationID.x;
    if (slice >= pc.slice_count) {
        return;
    }
    const uint base = pc.meta_base_dword + slice * pc.slice_stride_dword;
    const uint first = meta.words[base];
    uint uniform_words = 1u;
    for (uint i = 1u; i < pc.slice_dwords; ++i) {
        if (meta.words[base + i] != first) { uniform_words = 0u; break; }
    }
    uint matched = 0u;
    if (uniform_words == 1u) {
        if (first == pc.code0) { pred[slice * 4u + 0u] = 1u; matched = 1u; }
        else { pred[slice * 4u + 0u] = 0u; }
        if (pc.code_count > 1u && first == pc.code1) { pred[slice * 4u + 1u] = 1u; matched = 1u; }
        else if (pc.code_count > 1u) { pred[slice * 4u + 1u] = 0u; }
        if (pc.code_count > 2u && first == pc.code2) { pred[slice * 4u + 2u] = 1u; matched = 1u; }
        else if (pc.code_count > 2u) { pred[slice * 4u + 2u] = 0u; }
        if (pc.code_count > 3u && first == pc.code3) { pred[slice * 4u + 3u] = 1u; matched = 1u; }
        else if (pc.code_count > 3u) { pred[slice * 4u + 3u] = 0u; }
    } else {
        pred[slice * 4u + 0u] = 0u;
        if (pc.code_count > 1u) { pred[slice * 4u + 1u] = 0u; }
        if (pc.code_count > 2u) { pred[slice * 4u + 2u] = 0u; }
        if (pc.code_count > 3u) { pred[slice * 4u + 3u] = 0u; }
    }
    if (matched == 1u) {
        for (uint i = 0u; i < pc.slice_dwords; ++i) {
            meta.words[base + i] = 0xFFFFFFFFu;
        }
    }
}
